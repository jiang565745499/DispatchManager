@page "/error"

<div class="dashboard-page">
    <div class="dashboard-background"></div>
    <div class="dashboard-content" style="max-width:600px;margin:80px auto;text-align:center;">
        <div class="glass-card" style="padding:48px 32px;">
            <div style="font-size:64px;margin-bottom:24px;opacity:0.3;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h1 style="font-size:28px;font-weight:700;color:var(--color-text-primary);margin-bottom:8px;">出现错误</h1>
            <p style="font-size:16px;color:var(--color-text-secondary);margin-bottom:32px;">
                处理您的请求时发生了错误，请稍后重试。
            </p>
            <a href="/" class="glass-button glass-button--primary">
                <i class="fas fa-home me-2"></i>返回主页
            </a>
        </div>
    </div>
</div>