@page "/"
@using DispatchManager.Utils
@using DispatchManager.Schedule.Extensions
@using Longbow.Tasks
@inject ILogger<Index> Log
@attribute [TabItemOption(Text = "主页", Closable = false)]

<PageTitle>调度管理系统</PageTitle>

@{
    var allTasks = TaskServicesManager.ToList().ToTasksModelList();
    var totalCount = allTasks.Count;
    var runningCount = allTasks.Count(t => t.Status == SchedulerStatus.Running);
    var readyCount = allTasks.Count(t => t.Status == SchedulerStatus.Ready);
    var disabledCount = allTasks.Count(t => t.Status == SchedulerStatus.Disabled);
}

<div class="dashboard-page">
    <div class="dashboard-background"></div>
    
    <div class="dashboard-content">
        <!-- 页面标题区 -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">调度管理系统</h1>
            <p class="dashboard-subtitle">智能任务调度与管理系统</p>
        </div>
        
        <!-- 统计卡片区域 -->
        <div class="dashboard-stats">
            <div class="stat-card animate-fade-in-up" style="animation-delay: 0ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-tasks"></i>
                </div>
                <div class="stat-card__value">@totalCount</div>
                <div class="stat-card__label">总任务数</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 100ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-play-circle"></i>
                </div>
                <div class="stat-card__value">@runningCount</div>
                <div class="stat-card__label">运行中</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 200ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-pause-circle"></i>
                </div>
                <div class="stat-card__value">@readyCount</div>
                <div class="stat-card__label">已停止</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 300ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-ban"></i>
                </div>
                <div class="stat-card__value">@disabledCount</div>
                <div class="stat-card__label">已禁用</div>
            </div>
        </div>
        
        <!-- 内容区域 -->
        <div class="dashboard-main">
            <!-- 左侧：功能卡片 -->
            <div class="glass-card animate-fade-in-left" style="animation-delay: 400ms;">
                <div class="glass-card-header">
                    <h3 class="glass-card-title">功能模块</h3>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <a href="/DispatchTasks" class="action-button hover-lift" style="text-decoration:none;color:inherit;">
                            <div class="action-button__icon">
                                <i class="fas fa-flag"></i>
                            </div>
                            <div class="action-button__label">任务调度</div>
                            <p class="text-muted small mt-2">创建和管理定时任务</p>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/DispatchClass" class="action-button hover-lift" style="text-decoration:none;color:inherit;">
                            <div class="action-button__icon">
                                <i class="fas fa-cogs"></i>
                            </div>
                            <div class="action-button__label">任务分类</div>
                            <p class="text-muted small mt-2">对任务进行分类管理</p>
                        </a>
                    </div>
                    <div class="col-md-4">
                        <a href="/DispatchLog" class="action-button hover-lift" style="text-decoration:none;color:inherit;">
                            <div class="action-button__icon">
                                <i class="fas fa-database"></i>
                            </div>
                            <div class="action-button__label">任务日志</div>
                            <p class="text-muted small mt-2">查看任务执行日志</p>
                        </a>
                    </div>
                </div>
            </div>
            
            <!-- 右侧：快速开始 -->
            <div class="glass-card animate-fade-in-right" style="animation-delay: 500ms;">
                <div class="glass-card-header">
                    <h3 class="glass-card-title">快速开始</h3>
                </div>
                <div class="mb-4">
                    <div class="d-flex align-items-start mb-3">
                        <span class="glass-badge me-3" style="min-width:28px;justify-content:center;">1</span>
                        <div>
                            <div class="fw-semibold">创建任务分类</div>
                            <small class="text-muted">在"任务系统"中定义分类和金蝶对接配置</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <span class="glass-badge me-3" style="min-width:28px;justify-content:center;">2</span>
                        <div>
                            <div class="fw-semibold">配置定时任务</div>
                            <small class="text-muted">在"任务调度"中设置 Cron 表达式和请求地址</small>
                        </div>
                    </div>
                    <div class="d-flex align-items-start mb-3">
                        <span class="glass-badge me-3" style="min-width:28px;justify-content:center;">3</span>
                        <div>
                            <div class="fw-semibold">启动并监控</div>
                            <small class="text-muted">运行任务后在"任务日志"中查看执行结果</small>
                        </div>
                    </div>
                </div>
                <div class="text-muted small" style="padding-top:12px;border-top:1px solid var(--glass-border);">
                    <i class="fas fa-lightbulb text-warning me-1"></i>
                    使用侧边栏导航快速切换功能模块
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
    }
}