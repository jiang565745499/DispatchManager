@page "/"
@using DispatchManager.Utils
@inject ILogger<Index> Log
@attribute [TabItemOption(Text = "主页", Closable = false)]

<PageTitle>调度管理系统</PageTitle>

<div class="dashboard-page">
    <div class="dashboard-background"></div>
    
    <div class="dashboard-content">
        <!-- 页面标题区 -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">调度管理系统</h1>
            <p class="dashboard-subtitle">智能任务调度与管理系统</p>
        </div>
        
        <!-- 统计卡片区域 -->
        <div class="dashboard-stats">
            <div class="stat-card animate-fade-in-up" style="animation-delay: 0ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-tasks"></i>
                </div>
                <div class="stat-card__value">128</div>
                <div class="stat-card__label">总任务数</div>
                <div class="stat-card__trend">
                    <span class="trend-up">↑ 12%</span>
                    <span class="trend-label">较上周</span>
                </div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 100ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-play-circle"></i>
                </div>
                <div class="stat-card__value">24</div>
                <div class="stat-card__label">运行中</div>
                <div class="stat-card__trend">
                    <span class="trend-up">↑ 8%</span>
                    <span class="trend-label">较上周</span>
                </div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 200ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stat-card__value">96</div>
                <div class="stat-card__label">已完成</div>
                <div class="stat-card__trend">
                    <span class="trend-down">↓ 3%</span>
                    <span class="trend-label">较上周</span>
                </div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 300ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-card__value">8</div>
                <div class="stat-card__label">异常任务</div>
                <div class="stat-card__trend">
                    <span class="trend-up">↑ 15%</span>
                    <span class="trend-label">较上周</span>
                </div>
            </div>
        </div>
        
        <!-- 内容区域 -->
        <div class="dashboard-main">
            <!-- 左侧：功能卡片 -->
            <div class="glass-card animate-fade-in-left" style="animation-delay: 400ms;">
                <div class="glass-card-header">
                    <h3 class="glass-card-title">功能模块</h3>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="action-button hover-lift">
                            <div class="action-button__icon">
                                <i class="fas fa-tasks"></i>
                            </div>
                            <div class="action-button__label">任务调度</div>
                            <p class="text-muted small mt-2">创建和管理定时任务</p>
                            <a href="/DispatchTasks" class="glass-button glass-button--primary mt-3">
                                进入
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="action-button hover-lift">
                            <div class="action-button__icon">
                                <i class="fas fa-cogs"></i>
                            </div>
                            <div class="action-button__label">任务分类</div>
                            <p class="text-muted small mt-2">对任务进行分类管理</p>
                            <a href="/DispatchClass" class="glass-button glass-button--primary mt-3">
                                进入
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="action-button hover-lift">
                            <div class="action-button__icon">
                                <i class="fas fa-file-alt"></i>
                            </div>
                            <div class="action-button__label">任务日志</div>
                            <p class="text-muted small mt-2">查看任务执行日志</p>
                            <a href="/DispatchLog" class="glass-button glass-button--primary mt-3">
                                进入
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- 右侧：系统信息 -->
            <div class="glass-card animate-fade-in-right" style="animation-delay: 500ms;">
                <div class="glass-card-header">
                    <h3 class="glass-card-title">系统信息</h3>
                </div>
                <div class="mb-4">
                    <h5 class="fw-bold mb-3">
                        <i class="fas fa-info-circle text-primary me-2"></i>
                        系统特性
                    </h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            支持多种任务类型和触发器
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            实时监控任务执行状态
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            灵活的日志记录和查询
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check text-success me-2"></i>
                            支持金蝶系统集成
                        </li>
                    </ul>
                </div>
                <div>
                    <h5 class="fw-bold mb-3">
                        <i class="fas fa-clock text-primary me-2"></i>
                        快速开始
                    </h5>
                    <div class="mb-3">
                        <span class="modern-badge bg-primary text-white me-2">1</span>
                        创建任务分类
                    </div>
                    <div class="mb-3">
                        <span class="glass-badge">2</span>
                        配置定时任务
                    </div>
                    <div class="mb-3">
                        <span class="glass-badge">3</span>
                        启动并监控
                    </div>
                    <div class="text-muted small">
                        <i class="fas fa-lightbulb text-warning me-1"></i>
                        提示：使用侧边栏导航快速切换功能模块
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // 系统初始化代码可以在这里添加
    protected override void OnInitialized()
    {
        base.OnInitialized();
        // 可以在这里添加一些初始化逻辑
    }
}