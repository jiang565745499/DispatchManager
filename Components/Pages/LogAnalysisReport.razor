@page "/LogAnalysisReport"
@inject DispatchManager.DataAccess.FreeSql.Service.SqliteLogService LogDb

<PageTitle>日志分析报告</PageTitle>

<div class="page-container">
    <div class="content-wrapper">
        <!-- 页面标题 -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1 gradient-text">
                    <i class="fas fa-file-alt text-primary me-2"></i>
                    日志分析报告
                </h2>
                <p class="text-muted mb-0">系统日志的深度分析和报告生成</p>
            </div>
            <div class="text-end">
                <small class="text-muted">
                    <i class="fas fa-clock me-1"></i>
                    最后更新: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
                </small>
            </div>
        </div>

        <!-- 报告生成选项 -->
        <div class="modern-card p-5 mb-5 slide-in-left">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">
                    <i class="fas fa-cog text-primary me-2"></i>
                    报告生成选项
                </h5>
                <button class="btn btn-primary" @onclick="@GenerateReport">
                    <i class="fas fa-file-pdf me-1"></i>生成报告
                </button>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small">时间范围</label>
                    <select class="form-select" @bind="_timeRange">
                        <option value="24h">最近24小时</option>
                        <option value="7d">最近7天</option>
                        <option value="30d">最近30天</option>
                        <option value="custom">自定义</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small">开始日期</label>
                    <input type="date" class="form-control" @bind="_startDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small">结束日期</label>
                    <input type="date" class="form-control" @bind="_endDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small">日志级别</label>
                    <select class="form-select" @bind="_logLevel">
                        <option value="">所有级别</option>
                        <option value="ERROR">错误</option>
                        <option value="WARN">警告</option>
                        <option value="INFO">信息</option>
                        <option value="DEBUG">调试</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small">任务ID</label>
                    <input type="text" class="form-control" @bind="_taskId" placeholder="输入任务ID" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small">报告格式</label>
                    <select class="form-select" @bind="_reportFormat">
                        <option value="html">HTML</option>
                        <option value="csv">CSV</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- 报告摘要 -->
        @if (_reportData != null)
        {
            <div class="modern-card p-5 mb-5 slide-in-right">
                <h5 class="fw-bold mb-4">
                    <i class="fas fa-chart-pie text-primary me-2"></i>
                    报告摘要
                </h5>
                
                <div class="row g-4">
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded-lg">
                            <h6 class="text-muted mb-2">总日志数</h6>
                            <h3 class="fw-bold">@_reportData.TotalLogs</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded-lg">
                            <h6 class="text-muted mb-2">错误率</h6>
                            <h3 class="fw-bold text-danger">@_reportData.ErrorRate.ToString("F2")%</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded-lg">
                            <h6 class="text-muted mb-2">平均日志频率</h6>
                            <h3 class="fw-bold">@_reportData.AverageLogFrequency.ToString("F2")/小时</h3>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded-lg">
                            <h6 class="text-muted mb-2">问题任务数</h6>
                            <h3 class="fw-bold text-warning">@_reportData.ProblematicTasks</h3>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 详细分析 -->
            <div class="modern-card p-5 mb-5 slide-in-left">
                <h5 class="fw-bold mb-4">
                    <i class="fas fa-chart-bar text-primary me-2"></i>
                    详细分析
                </h5>
                
                <div class="mb-4">
                    <h6 class="fw-bold text-muted mb-2">日志级别分布</h6>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>级别</th>
                                    <th>数量</th>
                                    <th>占比</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _reportData.LogLevelDistribution)
                                {
                                    <tr>
                                        <td>@item.Level</td>
                                        <td>@item.Count</td>
                                        <td>@item.Percentage.ToString("F2")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted mb-2">任务错误统计</h6>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>任务ID</th>
                                    <th>错误次数</th>
                                    <th>总日志数</th>
                                    <th>错误率</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _reportData.TaskErrorStats)
                                {
                                    <tr>
                                        <td>@item.TaskId</td>
                                        <td>@item.ErrorCount</td>
                                        <td>@item.TotalCount</td>
                                        <td>@item.ErrorRate.ToString("F2")%</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted mb-2">时间趋势分析</h6>
                    <div class="chart-container" style="height: 300px;">
                        <canvas id="reportTrendChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- 导出按钮 -->
            <div class="d-flex justify-content-center gap-3 mb-5">
                <button class="btn btn-success" @onclick="@ExportReportAsHtml">
                    <i class="fas fa-file-html me-1"></i>导出HTML
                </button>
                <button class="btn btn-info" @onclick="@ExportReportAsCsv">
                    <i class="fas fa-file-csv me-1"></i>导出CSV
                </button>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // 初始化报告趋势图表
    window.initReportChart = function(trendData) {
        const ctx = document.getElementById('reportTrendChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: trendData.labels,
                datasets: [
                    {
                        label: '错误',
                        data: trendData.errorData,
                        borderColor: 'rgba(255, 99, 132, 1)',
                        backgroundColor: 'rgba(255, 99, 132, 0.1)',
                        tension: 0.4
                    },
                    {
                        label: '警告',
                        data: trendData.warnData,
                        borderColor: 'rgba(255, 206, 86, 1)',
                        backgroundColor: 'rgba(255, 206, 86, 0.1)',
                        tension: 0.4
                    },
                    {
                        label: '信息',
                        data: trendData.infoData,
                        borderColor: 'rgba(54, 162, 235, 1)',
                        backgroundColor: 'rgba(54, 162, 235, 0.1)',
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    };
</script>