@page "/LogDashboard"
@inject DispatchManager.DataAccess.FreeSql.Service.SqliteLogService LogDb

<PageTitle>日志仪表板</PageTitle>

<div class="page-container">
    <div class="content-wrapper">
        <!-- 页面标题 -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1 gradient-text">
                    <i class="fas fa-chart-pie text-primary me-2"></i>
                    日志仪表板
                </h2>
                <p class="text-muted mb-0">系统日志趋势分析和统计</p>
            </div>
            <div class="text-end">
                <small class="text-muted">
                    <i class="fas fa-clock me-1"></i>
                    最后更新: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
                </small>
            </div>
        </div>

        <!-- 关键指标卡片 -->
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="modern-card p-4 text-center fade-in stat-card-item">
                    <div class="mb-3">
                        <i class="fas fa-file-alt fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-2 stat-value">@TotalLogs</h4>
                    <small class="text-muted fw-500">总日志数</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="modern-card p-4 text-center fade-in stat-card-item">
                    <div class="mb-3">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                    </div>
                    <h4 class="fw-bold mb-2 stat-value">@ErrorLogs</h4>
                    <small class="text-muted fw-500">错误日志</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="modern-card p-4 text-center fade-in stat-card-item">
                    <div class="mb-3">
                        <i class="fas fa-exclamation-circle fa-3x text-warning"></i>
                    </div>
                    <h4 class="fw-bold mb-2 stat-value">@WarnLogs</h4>
                    <small class="text-muted fw-500">警告日志</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="modern-card p-4 text-center fade-in stat-card-item">
                    <div class="mb-3">
                        <i class="fas fa-info-circle fa-3x text-info"></i>
                    </div>
                    <h4 class="fw-bold mb-2 stat-value">@InfoLogs</h4>
                    <small class="text-muted fw-500">信息日志</small>
                </div>
            </div>
        </div>

        <!-- 时间趋势图表 -->
        <div class="modern-card p-5 mb-5 slide-in-right">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">
                    <i class="fas fa-chart-line text-primary me-2"></i>
                    日志时间趋势
                </h5>
                <div class="d-flex gap-2">
                    <select class="form-select form-select-sm" @bind="_timeRange">
                        <option value="24h">最近24小时</option>
                        <option value="7d">最近7天</option>
                        <option value="30d">最近30天</option>
                    </select>
                    <button class="btn btn-primary btn-sm" @onclick="@RefreshDashboard">
                        <i class="fas fa-refresh me-1"></i>刷新
                    </button>
                </div>
            </div>

            <div class="chart-container" style="height: 400px;">
                <canvas id="logTrendChart"></canvas>
            </div>
        </div>

        <!-- 日志级别分布 -->
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="modern-card p-5 slide-in-left">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-chart-pie text-primary me-2"></i>
                        日志级别分布
                    </h5>
                    <div class="chart-container" style="height: 300px;">
                        <canvas id="logLevelChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="modern-card p-5 slide-in-right">
                    <h5 class="fw-bold mb-4">
                        <i class="fas fa-chart-bar text-primary me-2"></i>
                        任务日志分布
                    </h5>
                    <div class="chart-container" style="height: 300px;">
                        <canvas id="taskLogChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- 最近错误日志 -->
        <div class="modern-card p-5 slide-in-left">
            <h5 class="fw-bold mb-4">
                <i class="fas fa-exclamation-triangle text-danger me-2"></i>
                最近错误日志
            </h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>时间</th>
                            <th>任务ID</th>
                            <th>错误消息</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in RecentErrorLogs)
                        {
                            <tr>
                                <td>@(log.Date?.ToString("yyyy-MM-dd HH:mm:ss") ?? "")</td>
                                <td>@(log.TaskID ?? 0)</td>
                                <td class="text-danger">@log.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // 初始化图表
    function initCharts(logTrendData, logLevelData, taskLogData) {
        // 日志时间趋势图表
        const trendCtx = document.getElementById('logTrendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: logTrendData.labels,
                datasets: [
                    {
                        label: '错误',
                        data: logTrendData.errorData,
                        borderColor: 'rgba(255, 99, 132, 1)',
                        backgroundColor: 'rgba(255, 99, 132, 0.1)',
                        tension: 0.4
                    },
                    {
                        label: '警告',
                        data: logTrendData.warnData,
                        borderColor: 'rgba(255, 206, 86, 1)',
                        backgroundColor: 'rgba(255, 206, 86, 0.1)',
                        tension: 0.4
                    },
                    {
                        label: '信息',
                        data: logTrendData.infoData,
                        borderColor: 'rgba(54, 162, 235, 1)',
                        backgroundColor: 'rgba(54, 162, 235, 0.1)',
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // 日志级别分布图表
        const levelCtx = document.getElementById('logLevelChart').getContext('2d');
        new Chart(levelCtx, {
            type: 'pie',
            data: {
                labels: logLevelData.labels,
                datasets: [{
                    data: logLevelData.data,
                    backgroundColor: [
                        'rgba(255, 99, 132, 0.8)',
                        'rgba(255, 206, 86, 0.8)',
                        'rgba(54, 162, 235, 0.8)',
                        'rgba(75, 192, 192, 0.8)'
                    ],
                    borderColor: [
                        'rgba(255, 99, 132, 1)',
                        'rgba(255, 206, 86, 1)',
                        'rgba(54, 162, 235, 1)',
                        'rgba(75, 192, 192, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });

        // 任务日志分布图表
        const taskCtx = document.getElementById('taskLogChart').getContext('2d');
        new Chart(taskCtx, {
            type: 'bar',
            data: {
                labels: taskLogData.labels,
                datasets: [{
                    label: '日志数量',
                    data: taskLogData.data,
                    backgroundColor: 'rgba(54, 162, 235, 0.8)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    }

    // 初始化图表数据
    window.initLogDashboard = function(logTrendData, logLevelData, taskLogData) {
        initCharts(logTrendData, logLevelData, taskLogData);
    };
</script>