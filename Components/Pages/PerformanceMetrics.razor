@page "/PerformanceMetrics"
@using DispatchManager.Schedule.Service

<PageTitle>性能指标分析</PageTitle>

<div class="page-container">
    <div class="content-wrapper">
        <!-- 页面标题 -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1 gradient-text">
                    <i class="fas fa-chart-line text-primary me-2"></i>
                    性能指标分析
                </h2>
                <p class="text-muted mb-0">监控和分析系统性能指标</p>
            </div>
            <div class="text-end">
                <small class="text-muted">
                    <i class="fas fa-clock me-1"></i>
                    最后更新: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
                </small>
            </div>
        </div>

        <!-- 统计卡片 -->
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="modern-card p-4 text-center fade-in stat-card-item">
                    <div class="mb-3">
                        <i class="fas fa-tasks fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-2 stat-value">@TotalOperations</h4>
                    <small class="text-muted fw-500">操作类型</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="modern-card p-4 text-center fade-in stat-card-item">
                    <div class="mb-3">
                        <i class="fas fa-execution fa-3x text-success"></i>
                    </div>
                    <h4 class="fw-bold mb-2 stat-value">@TotalExecutions</h4>
                    <small class="text-muted fw-500">总执行次数</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="modern-card p-4 text-center fade-in stat-card-item">
                    <div class="mb-3">
                        <i class="fas fa-exclamation-triangle fa-3x text-danger"></i>
                    </div>
                    <h4 class="fw-bold mb-2 stat-value">@TotalErrors</h4>
                    <small class="text-muted fw-500">错误次数</small>
                </div>
            </div>
            <div class="col-md-3">
                <div class="modern-card p-4 text-center fade-in stat-card-item">
                    <div class="mb-3">
                        <i class="fas fa-stopwatch fa-3x text-info"></i>
                    </div>
                    <h4 class="fw-bold mb-2 stat-value">@AverageExecutionTime</h4>
                    <small class="text-muted fw-500">平均执行时间(ms)</small>
                </div>
            </div>
        </div>

        <!-- 性能指标表格 -->
        <div class="modern-card p-5 mb-5 slide-in-right">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">
                    <i class="fas fa-table text-primary me-2"></i>
                    性能指标详情
                </h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-secondary btn-sm" @onclick="@ResetMetrics">
                        <i class="fas fa-sync-alt me-1"></i>重置指标
                    </button>
                    <button class="btn btn-primary btn-sm" @onclick="@RefreshMetrics">
                        <i class="fas fa-refresh me-1"></i>刷新
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>操作名称</th>
                            <th>执行次数</th>
                            <th>错误次数</th>
                            <th>错误率</th>
                            <th>平均执行时间(ms)</th>
                            <th>最后执行时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var metric in Metrics)
                        {
                            <tr>
                                <td>
                                    <span class="font-weight-bold">@metric.OperationName</span>
                                </td>
                                <td>@metric.TotalExecutions</td>
                                <td>
                                    <span class="badge @(metric.ErrorCount > 0 ? "bg-danger" : "bg-success")">
                                        @metric.ErrorCount
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(metric.ErrorRate > 5 ? "bg-danger" : metric.ErrorRate > 0 ? "bg-warning" : "bg-success")">
                                        @metric.ErrorRate.ToString("F2")%
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(metric.AverageExecutionTime > 1000 ? "bg-danger" : metric.AverageExecutionTime > 500 ? "bg-warning" : "bg-success")">
                                        @metric.AverageExecutionTime.ToString("F2")
                                    </span>
                                </td>
                                <td>@metric.LastExecutionTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 慢查询检测 -->
        <div class="modern-card p-5 mb-5 slide-in-left">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">
                    <i class="fas fa-exclamation-triangle text-warning me-2"></i>
                    慢查询检测
                </h5>
                <div class="d-flex gap-2">
                    <input type="number" class="form-control form-control-sm" @bind="_slowQueryThreshold" placeholder="阈值(ms)" min="100" max="5000" />
                    <button class="btn btn-warning btn-sm" @onclick="@RefreshSlowQueries">
                        <i class="fas fa-search me-1"></i>检测
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>操作名称</th>
                            <th>执行时间(ms)</th>
                            <th>状态</th>
                            <th>错误信息</th>
                            <th>时间戳</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in SlowQueries)
                        {
                            <tr class="table-warning">
                                <td>@record.OperationName</td>
                                <td>
                                    <span class="badge bg-danger">
                                        @record.ExecutionTime.TotalMilliseconds.ToString("F2")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(record.IsError ? "bg-danger" : "bg-success")">
                                        @(record.IsError ? "错误" : "成功")
                                    </span>
                                </td>
                                <td>
                                    @if (record.IsError && !string.IsNullOrEmpty(record.ErrorMessage))
                                    {
                                        <span class="text-danger small">@record.ErrorMessage</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@record.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 性能记录表格 -->
        <div class="modern-card p-5 slide-in-left">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="fw-bold mb-0">
                    <i class="fas fa-history text-primary me-2"></i>
                    最近性能记录
                </h5>
                <div class="d-flex gap-2">
                    <input type="text" class="form-control form-control-sm" @bind="_operationFilter" placeholder="操作名称" />
                    <button class="btn btn-primary btn-sm" @onclick="@FilterRecords">
                        <i class="fas fa-search me-1"></i>过滤
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>操作名称</th>
                            <th>执行时间(ms)</th>
                            <th>状态</th>
                            <th>错误信息</th>
                            <th>时间戳</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in FilteredRecords)
                        {
                            <tr>
                                <td>@record.OperationName</td>
                                <td>
                                    <span class="badge @(record.ExecutionTime.TotalMilliseconds > 1000 ? "bg-danger" : record.ExecutionTime.TotalMilliseconds > 500 ? "bg-warning" : "bg-success")">
                                        @record.ExecutionTime.TotalMilliseconds.ToString("F2")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(record.IsError ? "bg-danger" : "bg-success")">
                                        @(record.IsError ? "错误" : "成功")
                                    </span>
                                </td>
                                <td>
                                    @if (record.IsError && !string.IsNullOrEmpty(record.ErrorMessage))
                                    {
                                        <span class="text-danger small">@record.ErrorMessage</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@record.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>