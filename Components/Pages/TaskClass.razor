@page "/DispatchClass"
@using DispatchManager.Components.Shared.TaskClass
@inject DispatchManager.DataAccess.FreeSql.Service.DispatchClassService MainDb
@inject DispatchManager.DataAccess.FreeSql.Service.SqliteLogService LogDb

<PageTitle>任务系统</PageTitle>

@{
    var classList = MainDb?.GetAllDispatchClass() ?? [];
    var classCount = classList.Count;
    var colorCount = classList.Count(c => !string.IsNullOrEmpty(c.FColor.ToString()));
}

<div class="dashboard-page">
    <div class="dashboard-background"></div>
    
    <div class="dashboard-content">
        <!-- 页面标题区 -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">任务系统</h1>
            <p class="dashboard-subtitle">对任务进行分类管理，便于组织和维护</p>
        </div>
        
        <!-- 统计卡片区域 -->
        <div class="dashboard-stats">
            <div class="stat-card animate-fade-in-up" style="animation-delay: 0ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div class="stat-card__value">@classCount</div>
                <div class="stat-card__label">总分类数</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 100ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-palette"></i>
                </div>
                <div class="stat-card__value">@colorCount</div>
                <div class="stat-card__label">已配置颜色</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 200ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <div class="stat-card__value">100%</div>
                <div class="stat-card__label">系统状态</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 300ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-cogs"></i>
                </div>
                <div class="stat-card__value">100%</div>
                <div class="stat-card__label">可用率</div>
            </div>
        </div>
        
        <!-- 表格卡片 -->
        <div class="glass-table-container animate-fade-in-up" style="animation-delay: 400ms;">
            <div class="glass-table-header">
                <h3 class="glass-table-title">任务分类列表</h3>
                <span class="glass-table-badge">@classCount 条记录</span>
            </div>
            <div class="dtc-card-body">
                <Table TItem="DispatchClass" ExtendButtonColumnWidth="270" IsFixedHeader="false" SortString="CreateTime desc"
                       IsPagination="true" PageItemsSource="@PageItemsSource"
                       ShowExtendButtons="true"
                       IsAutoRefresh="true"
                       ShowExportButton="true"
                       ShowToolbar="true" ShowDefaultButtons="true" ShowSearch="true" IsMultipleSelect="true"
                       SelectedRows="SelectedRows"
                       ShowEditButtonCallback="OnShowButtonCallback"
                       ShowDeleteButtonCallback="OnShowButtonCallback"
                       OnQueryAsync="OnQueryAsync"
                       OnDeleteAsync="OnDeleteAsync"
                       OnSaveAsync="OnSaveAsync">
                    <TableColumns>
                        <TableColumn @bind-Field="@context.ClassName" Sortable="true" Filterable="false" Searchable="true" TextWrap="true">
                            <Template Context="v">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-tag text-primary me-2"></i>
                                    <span>@v.Value</span>
                                </div>
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.FColor">
                            <Template Context="v">
                                <div class="d-flex align-items-center">
                                    <div class="me-2" style="background-color: @v.Value; width: 16px; height: 16px; border-radius: 50%; border: 2px solid #e2e8f0;"></div>
                                    <Tag Color="v.Value">颜色标识</Tag>
                                </div>
                            </Template>
                        </TableColumn>
                    </TableColumns>
                    <EditTemplate>
                        <TaskClassEditor @bind-Value="context" />
                    </EditTemplate>
                </Table>
            </div>
        </div>
    </div>
</div>
