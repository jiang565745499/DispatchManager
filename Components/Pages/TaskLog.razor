@page "/DispatchLog"
@inject DispatchManager.DataAccess.FreeSql.Service.ScheduleTaskService MainDb
@inject DispatchManager.DataAccess.FreeSql.Service.ScheduleTaskKingDeeService MainDbKingDee
@inject DispatchManager.DataAccess.FreeSql.Service.SqliteLogService LogDb

<PageTitle>任务日志</PageTitle>

<div class="dashboard-page">
    <div class="dashboard-background"></div>
    
    <div class="dashboard-content">
        <!-- 页面标题区 -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">任务日志</h1>
            <p class="dashboard-subtitle">查看和分析系统任务的执行日志</p>
        </div>
        
        <!-- 统计卡片区域 -->
        <div class="dashboard-stats">
            <div class="stat-card animate-fade-in-up" style="animation-delay: 0ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                <div class="stat-card__value">@(LogDb?.GetAllLog()?.Count() ?? 0)</div>
                <div class="stat-card__label">总日志数</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 100ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <div class="stat-card__value">@(LogDb?.GetAllLog()?.Count(l => l.Level?.ToLower() == "error") ?? 0)</div>
                <div class="stat-card__label">错误日志</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 200ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-info-circle"></i>
                </div>
                <div class="stat-card__value">@(LogDb?.GetAllLog()?.Count(l => l.Level?.ToLower() == "information") ?? 0)</div>
                <div class="stat-card__label">信息日志</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 300ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-exclamation-circle"></i>
                </div>
                <div class="stat-card__value">@(LogDb?.GetAllLog()?.Count(l => l.Level?.ToLower() == "warn") ?? 0)</div>
                <div class="stat-card__label">警告日志</div>
            </div>
        </div>
        
        <!-- 日志说明卡片 -->
        

        <!-- 数据表格 -->
        <div class="glass-table-container animate-fade-in-up" style="animation-delay: 400ms;">
            <div class="glass-table-header">
                <h3 class="glass-table-title">系统日志列表</h3>
                <div class="glass-table-badge">
                    <button class="glass-button glass-button--sm" @onclick="@ExportLogsToExcel">
                        <i class="fas fa-file-excel me-1"></i>导出Excel
                    </button>
                    <button class="glass-button glass-button--sm" @onclick="@ExportLogsToCsv">
                        <i class="fas fa-file-csv me-1"></i>导出CSV
                    </button>
                </div>
            </div>
            <div class="dtc-card-body">
                <Table TItem="Log"
                       IsFixedHeader="false"
                       SortString="Timestamp desc"
                       IsPagination="true" PageItemsSource="@PageItemsSource"
                       ShowExtendButtons="false"
                       IsAutoRefresh="false"
                       ShowExportButton="false"
                       ShowToolbar="true" ShowDefaultButtons="false"
                       ShowSearch="true"
                       IsMultipleSelect="false"
                       SelectedRows="SelectedRows"
                       OnQueryAsync="OnQueryAsync">
                    <TableColumns>
                        <TableColumn @bind-Field="@context.Date"
                                     Sortable="false" Filterable="false"
                                     FormatString="yyyy-MM-dd HH:mm:ss"
                                     Width="170">
                            <Template Context="v">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-calendar text-muted me-2"></i>
                                    <small class="fw-bold">@v.Value</small>
                                </div>
                            </Template>
                        </TableColumn>

                        <TableColumn @bind-Field="@context.Level"
                                     Text="级别"
                                     Sortable="true" Filterable="false"
                                     Width="90">
                            <Template Context="v">
                                <Tag Color="@GetLevelColor(v.Value)">
                                    @switch (v.Value?.ToLower())
                                {
                                    case "error":
                                    case "fatal":
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        break;
                                    case "warn":
                                    case "warning":
                                        <i class="fas fa-exclamation-circle me-1"></i>
                                        break;
                                    case "info":
                                    case "information":
                                        <i class="fas fa-info-circle me-1"></i>
                                        break;
                                    case "debug":
                                        <i class="fas fa-bug me-1"></i>
                                        break;
                                    default:
                                        <i class="fas fa-question me-1"></i>
                                        break;
                                }
                                    @(v.Value ?? "-")
                                </Tag>
                            </Template>
                        </TableColumn>

                        <TableColumn @bind-Field="@context.TaskID"
                                     Text="任务名称"
                                     Sortable="false" Filterable="false"
                                     Width="180">
                            <Template Context="v">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-tasks text-muted me-2"></i>
                                    <span>@GetTaskName(v.Value)</span>
                                </div>
                            </Template>
                        </TableColumn>

                        <TableColumn @bind-Field="@context.Message"
                                     Text="日志消息"
                                     Searchable="true" Filterable="false"
                                     TextWrap="true"
                                     Width="320">
                            <Template Context="v">
                                <div class="d-flex align-items-start">
                                    <i class="fas fa-comment text-muted me-2 mt-1"></i>
                                    <div class="flex-fill">
                                        @if (!string.IsNullOrEmpty(v.Value))
                                        {
                                            <div class="text-break">@v.Value</div>
                                            @if (v.Value.Length > 100)
                                            {
                                                <small class="text-muted">
                                                    <i class="fas fa-expand-arrows-alt me-1"></i>
                                                    长文本内容
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <div class="text-muted">无日志内容</div>
                                        }
                                    </div>
                                </div>
                            </Template>
                        </TableColumn>

                        <TableColumn @bind-Field="@context.Exception"
                                     Text="异常信息"
                                     Filterable="false"
                                     TextWrap="true"
                                     Width="280">
                            <Template Context="v">
                                @if (!string.IsNullOrEmpty(v.Value))
                                {
                                    <div class="d-flex align-items-start">
                                        <i class="fas fa-exclamation-triangle text-danger me-2 mt-1"></i>
                                        <div class="flex-fill">
                                            <div class="text-break text-danger small">@v.Value</div>
                                            <small class="text-muted">
                                                <i class="fas fa-bug me-1"></i>
                                                异常详情
                                            </small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        <i class="fas fa-check me-1"></i> 无异常
                                    </span>
                                }
                            </Template>
                        </TableColumn>
                    </TableColumns>
                </Table>

                @if (_lastQueryIsSearch && _lastQueryTotalCount == 0)
                {
                    <div class="alert alert-warning mt-3 mb-0 d-flex align-items-center" role="alert">
                        <i class="fas fa-search-minus me-2"></i>
                        <div>
                            未找到与关键词“@_lastSearchKeyword”相关的日志记录或任务名称，请尝试更短关键词或清空搜索。
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="modern-card p-5 mb-5 slide-in-left info-section">
            <div class="d-flex align-items-center mb-4">
                <i class="fas fa-info-circle text-primary me-2 fa-lg"></i>
                <h5 class="fw-bold mb-0">日志说明</h5>
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="mb-3">
                        <h6 class="fw-bold text-primary mb-2">
                            <i class="fas fa-exclamation-triangle text-danger me-1"></i>
                            错误级别 (ERROR)
                        </h6>
                        <p class="text-muted small mb-0">任务执行失败、系统异常等严重问题</p>
                    </div>
                    <div class="mb-3">
                        <h6 class="fw-bold text-warning mb-2">
                            <i class="fas fa-exclamation-circle text-warning me-1"></i>
                            警告级别 (WARN)
                        </h6>
                        <p class="text-muted small mb-0">潜在问题、性能警告等需要注意的情况</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <h6 class="fw-bold text-info mb-2">
                            <i class="fas fa-info-circle text-info me-1"></i>
                            信息级别 (INFO)
                        </h6>
                        <p class="text-muted small mb-0">任务执行状态、正常操作记录</p>
                    </div>
                    <div class="mb-3">
                        <h6 class="fw-bold text-success mb-2">
                            <i class="fas fa-check-circle text-success me-1"></i>
                            调试级别 (DEBUG)
                        </h6>
                        <p class="text-muted small mb-0">详细的调试信息和系统状态</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    function downloadFile(fileName, contentType, base64Content) {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = `data:${contentType};base64,${base64Content}`;
        link.click();
    }
</script>
