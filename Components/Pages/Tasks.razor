@page "/DispatchTasks"
@using DispatchManager.Components.Shared.Tasks
@using DispatchManager.Schedule.Extensions

@inject DispatchManager.DataAccess.FreeSql.Service.ScheduleTaskService MainDb
@inject DispatchManager.DataAccess.FreeSql.Service.DispatchClassService MainDb2
@inject DispatchManager.DataAccess.FreeSql.Service.SqliteLogService LogDb

<PageTitle>任务调度</PageTitle>

@{    var allTasks = TaskServicesManager.ToList().ToTasksModelList();    var dbTasks = MainDb?.GetAllDispatchTask() ?? [];    allTasks.ForEach(task =>    {        var dbTask = dbTasks.FirstOrDefault(t => t.Name == task.Name);        if (dbTask != null)        {            task.ID = dbTask.ID;            task.ApiUrl = dbTask.ApiUrl;            task.ReturnApiUrl = dbTask.ReturnApiUrl;            task.ClassID = dbTask.ClassID;            task.FNo = dbTask.FNo;            task.IsLog = dbTask.IsLog;            task.FISRetry = dbTask.FISRetry;            task.DllPath = dbTask.DllPath;            task.MethodName = dbTask.MethodName;            task.IsDllTask = dbTask.IsDllTask;        }    });    allTasks = allTasks.Where(x => x.ID != null).ToList();    var totalCount = allTasks.Count;    var runningCount = allTasks.Count(t => t.Status == SchedulerStatus.Running);    var readyCount = allTasks.Count(t => t.Status == SchedulerStatus.Ready);    var disabledCount = allTasks.Count(t => t.Status == SchedulerStatus.Disabled);}

<div class="dashboard-page">
    <div class="dashboard-background"></div>
    
    <div class="dashboard-content">
        <!-- 页面标题区 -->
        <div class="dashboard-header">
            <h1 class="dashboard-title">任务调度</h1>
            <p class="dashboard-subtitle">创建和管理定时任务，支持Cron表达式</p>
        </div>
        
        <!-- 统计卡片区域 -->
        <div class="dashboard-stats">
            <div class="stat-card animate-fade-in-up" style="animation-delay: 0ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div class="stat-card__value">@totalCount</div>
                <div class="stat-card__label">总任务数</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 100ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-play"></i>
                </div>
                <div class="stat-card__value">@runningCount</div>
                <div class="stat-card__label">运行中</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 200ms;">
                <div class="stat-card__icon">
                    <i class="fas fa-pause"></i>
                </div>
                <div class="stat-card__value">@readyCount</div>
                <div class="stat-card__label">已停止</div>
            </div>
            <div class="stat-card animate-fade-in-up" style="animation-delay: 300ms;">
                <div class="stat-card__icon">
                    <i class="fa-solid fa-ban"></i>
                </div>
                <div class="stat-card__value">@disabledCount</div>
                <div class="stat-card__label">已禁用</div>
            </div>
        </div>
        
        <!-- 表格卡片 -->
        <div class="glass-table-container animate-fade-in-up" style="animation-delay: 400ms;">
            <div class="glass-table-header">
                <h3 class="glass-table-title">任务调度列表</h3>
                <span class="glass-table-badge">@totalCount 条记录</span>
            </div>
            <div class="dtc-card-body">
                <Table TItem="DispatchTask" ExtendButtonColumnWidth="270" IsFixedHeader="false" SortString="FNo asc"
                       IsPagination="true" PageItemsSource="@PageItemsSource"
                       ShowExtendButtons="true"
                       IsAutoRefresh="true"
                       ShowExportButton="true"
                       ShowToolbar="true" ShowDefaultButtons="true" ShowSearch="true" IsMultipleSelect="true"
                       SelectedRows="SelectedRows"
                       ShowEditButtonCallback="OnShowButtonCallback"
                       ShowDeleteButtonCallback="OnShowButtonCallback"
                       OnQueryAsync="OnQueryAsync"
                       OnDeleteAsync="OnDeleteAsync"
                       OnSaveAsync="OnSaveAsync"
                       ConfirmDelete="true">
                    <TableColumns>
                        <TableColumn @bind-Field="@context.FNo" Sortable="true" Width="80">
                            <Template Context="v">
                                <span class="fw-semibold text-primary">#@v.Value</span>
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.ClassID" Sortable="true" Filterable="false" Searchable="true">
                            <Template Context="v">
                                <Tag Color="GetClassNameColor(v.Value)">
                                    <i class="fas fa-tag me-1"></i>
                                    @FormatClassName(v.Value)
                                </Tag>
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.Name" Sortable="true" Filterable="false" Searchable="true" Width="140">
                            <Template Context="v">
                                <strong>@v.Value</strong>
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.LastRuntime" Sortable="true" FormatString="yyyy-MM-dd HH:mm:ss" Width="160">
                            <Template Context="v">
                                <small class="text-muted">@v.Value</small>
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.NextRuntime" Sortable="true" FormatString="yyyy-MM-dd HH:mm:ss" Width="160">
                            <Template Context="v">
                                <small class="fw-bold text-primary">@v.Value</small>
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.Trigger" Sortable="true" Searchable="true" TextWrap="true">
                            <Template Context="v">
                                <span class="dtc-type-tag">@v.Value</span>
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.ApiUrl" Searchable="true" TextWrap="true">
                            <Template Context="v">
                                @if (IsApiUrlExpanded(v.Value))
                                {
                                    <div style="max-width:260px;">
                                        <button type="button"
                                                class="btn btn-link p-0 text-start"
                                                title="点击收起请求地址"
                                                @onclick="() => ToggleApiUrlExpand(v.Value)">
                                            收起
                                        </button>
                                        <div class="mt-1 p-1 border rounded text-break"
                                             style="max-width:260px; user-select:text; -webkit-user-select:text; cursor:text; white-space:normal;">
                                            @v.Value
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-link p-0 text-start d-inline-block"
                                            style="max-width:260px;"
                                            title="点击展开完整请求地址"
                                            @onclick="() => ToggleApiUrlExpand(v.Value)">
                                        <span class="text-truncate d-inline-block" style="max-width:260px;">@v.Value</span>
                                    </button>
                                }
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.LastRunResult" Sortable="true" Width="90">
                            <Template Context="v">
                                <span class="dtc-status">
                                    <span class="dtc-dot @GetResultDotClass(v.Value)"></span>
                                    @FormatResult(v.Value)
                                </span>
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.Status" Sortable="true" Width="90">
                            <Template Context="v">
                                <span class="dtc-status">
                                    <span class="dtc-dot @GetStatusDotClass(v.Value)"></span>
                                    @FormatStatus(v.Value)
                                </span>
                            </Template>
                        </TableColumn>
                    </TableColumns>
                    <EditTemplate>
                        <TaskEditor @bind-Value="context" />
                    </EditTemplate>
                    <RowButtonTemplate>
                        <TableCellButton Size="Size.ExtraSmall" Color="Color.Dark" Icon="fa-solid fa-ban" Text="禁用" OnClick="() => OnDisable(context)" IsShow="OnCheckTaskStatus(context)" AutoRenderTableWhenClick="true" />
                        <TableCellButton Size="Size.ExtraSmall" Color="Color.Warning" Icon="fa-solid fa-pause" Text="暂停" OnClick="() => OnPause(context)" IsShow="OnCheckTaskStatus(context)" AutoRenderTableWhenClick="true" />
                        <TableCellButton Size="Size.ExtraSmall" Color="Color.Success" Icon="fa-solid fa-play" Text="运行" OnClick="() => OnRun(context)" IsShow="OnCheckTaskStatus2(context)" AutoRenderTableWhenClick="true" />
                        <TableCellButton Size="Size.ExtraSmall" Color="Color.Info" Icon="fa-solid fa-file-alt" Text="日志" OnClick="() => OnLog(context)" IsShow="OnCheckTaskStatus(context)" AutoRenderTableWhenClick="true" />
                    </RowButtonTemplate>
                </Table>
            </div>
        </div>
    </div>
</div>
