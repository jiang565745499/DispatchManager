<div class="row g-3 form-inline">
    <div class="col-12">
        <div class="col-6">
            <BootstrapInput @bind-Value="@Value.ClassName" />
         </div>
        <div class="col-6">
            <Select @bind-Value="@Value.FColor" Items="Items" />
        </div>
    </div>
    <div class="col-12">
        <BootstrapInput @bind-Value="@Value.Y9Key" />
    </div>
</div>
<div class="col-12" style="margin-top:22px;">
    <Collapse IsAccordion="true">
        <CollapseItems>
            <CollapseItem Text="金蝶对接配置(点击展开)" TitleColor="Color.Primary">
                <BootstrapInput @bind-Value="@Value.KingDeeAccountID" />
                <BootstrapInput @bind-Value="@Value.KingDeeUserName" />
                <BootstrapInput @bind-Value="@Value.KingDeeAppID" />
                <BootstrapInput @bind-Value="@Value.KingDeeAppSec" />
                <BootstrapInput @bind-Value="@Value.KingDeeLCID"/>
                <BootstrapInput @bind-Value="@Value.KingDeeServerUrl" />
            </CollapseItem>
        </CollapseItems>
    </Collapse>
</div>