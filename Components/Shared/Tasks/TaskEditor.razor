@inject DispatchManager.DataAccess.FreeSql.Service.DispatchClassService MainDb

<div class="row g-3 form-inline">
    <div class="col-12">
        <BootstrapInput  @bind-Value="@Value.FNo" />
    </div>
    <div class="col-12">
        <BootstrapInput  @bind-Value="@Value.Name" />
    </div>
    <div class="col-12">
        <Select @bind-Value="@Value.ClassID" Items="Items" />
    </div>
    <div class="col-12">
        <BootstrapInputNumber @bind-Value="@Value.TimeNumber" />

        <Select @bind-Value="@Value.TimeType" Items="ItemCronSelect" />

        <div class="col-6 "><Button IsOutline="true" OnClick="() => OnCreateCron(Value)" Color="Color.Primary">生成Cron</Button></div>

    </div>
    <div class="col-12">
        <BootstrapInput @bind-Value="@Value.Trigger" />
        <button type="button" class="btn btn-primary" @onclick="@(e => IsOpen = true)">获取Cron</button>
        <Drawer IsBackdrop="true" OnCloseAsync="()=>OnCloseDrawer()" Placement="Placement.Right" IsOpen="@IsOpen" AllowResize="true">
            <div class="d-flex justify-content-center align-items-center flex-column" style="height: 100%;--bb-drawer-width: 500px;">
                <IFrame Src="https://cron.qqe2.com/"></IFrame>
            </div>
        </Drawer>
    </div>
    <div class="col-12">
        <BootstrapInput @bind-Value="@Value.ApiUrl" />
    </div>
    <div class="col-12">
        <BootstrapInput @bind-Value="@Value.ReturnApiUrl" />
    </div>
    <div class="col-12">
        <Select @bind-Value="@ResponseTypeValue" Items="ItemResponseTypeSelect" />
    </div>
    <div class="col-12">
        <Switch ValueChanged="()=>OnValueChanged(Value)" Value="@Value.IsLog" OnColor="Color.Success" OnText="开启日志" OffText="关闭日志"></Switch>
        <Switch ValueChanged="() => OnFISRetryChanged(Value)" Value="@Value.FISRetry" OnColor="Color.Warning" OnText="开启重试" OffText="关闭重试"></Switch>
        <Switch ValueChanged="async () => await OnIsDllTaskChanged(Value)" Value="@Value.IsDllTask" OnColor="Color.Info" OnText="DLL任务" OffText="API任务"></Switch>

    </div>
    @* <div class="col-12">
    </div>
    <div class="col-12">
    </div> *@
    @if (Value.IsDllTask)
    {
        @* <div class="col-12">
            
        </div> *@
        @* <label class="form-label">DLL文件上传</label> *@
        <ButtonUpload TValue="UploadFile" OnChange="OnFileUpload" accept=".dll" IsMultiple="false" ShowProgress ="true"/>
        <div class="col-12">
            <BootstrapInput @bind-Value="Value.DllPath" PlaceHolder="DLL文件路径" />
        </div>
        <div class="col-12">
            <BootstrapInput @bind-Value="Value.MethodName" PlaceHolder="要执行的方法名" />
        </div>
    }
</div>